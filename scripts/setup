#!/usr/bin/env bash
# Get a clean checkout to a runnable state. Must be idempotent.
set -euo pipefail
cd "$(dirname "$0")/.."

chmod +x scripts/*

if ! command -v uv >/dev/null 2>&1; then
  printf '\033[31m✗ uv not found — `brew install uv` (or see https://docs.astral.sh/uv/).\033[0m\n' >&2
  exit 1
fi

# Installs the pinned Python from .python-version and the locked dev tools.
# The plugin itself has no runtime dependencies.
uv sync --locked

# Sublime imports this checkout as the package `SublimeAgentOverview`; tests and the type
# checker import it by that name through these links (see pyproject.toml). Links
# per subpackage, not to the root: a link to the root would sit inside the package
# it points at, and Sublime's resource scan would recurse into it.
mkdir -p .venv/pkgroot/SublimeAgentOverview
for init in */__init__.py; do
  ln -sfn "$PWD/${init%/__init__.py}" ".venv/pkgroot/SublimeAgentOverview/${init%/__init__.py}"
done

echo "✓ setup complete"
